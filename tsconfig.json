{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,  // ✅ optional but recommended

    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "strict": true,
     "jsx": "react-jsx",
    "skipLibCheck": true
    
  },
  "include": ["src"]
}




